import math

class TicTacToeAI:
    def __init__(self):
        self.board = [' ' for _ in range(9)]
        self.human = 'X'
        self.ai = 'O'

    def print_board(self):
        print("\n")
        for row in [self.board[i*3:(i+1)*3] for i in range(3)]:
            print('| ' + ' | '.join(row) + ' |')
        print("\n")

    def available_moves(self):
        return [i for i, spot in enumerate(self.board) if spot == ' ']

    def empty_squares(self):
        return ' ' in self.board

    def make_move(self, square, letter):
        if self.board[square] == ' ':
            self.board[square] = letter
            return True
        return False

    def check_winner(self, board, player):
        # Winning combinations
        win_conditions = [
            [0, 1, 2], [3, 4, 5], [6, 7, 8], # Horizontal
            [0, 3, 6], [1, 4, 7], [2, 5, 8], # Vertical
            [0, 4, 8], [2, 4, 6]             # Diagonal
        ]
        return any(all(board[spot] == player for spot in combo) for combo in win_conditions)

    def is_terminal(self):
        return self.check_winner(self.board, self.human) or \
               self.check_winner(self.board, self.ai) or \
               not self.empty_squares()

    def minimax(self, state, depth, is_maximizing):
        if self.check_winner(state, self.ai):
            return {'score': 10 - depth}
        elif self.check_winner(state, self.human):
            return {'score': depth - 10}
        elif not ' ' in state:
            return {'score': 0}

        if is_maximizing:
            best = {'score': -math.inf, 'position': None}
            for possible_move in [i for i, spot in enumerate(state) if spot == ' ']:
                state[possible_move] = self.ai
                sim_score = self.minimax(state, depth + 1, False)
                state[possible_move] = ' '
                sim_score['position'] = possible_move
                
                if sim_score['score'] > best['score']:
                    best = sim_score
            return best
        else:
            best = {'score': math.inf, 'position': None}
            for possible_move in [i for i, spot in enumerate(state) if spot == ' ']:
                state[possible_move] = self.human
                sim_score = self.minimax(state, depth + 1, True)
                state[possible_move] = ' '
                sim_score['position'] = possible_move
                
                if sim_score['score'] < best['score']:
                    best = sim_score
            return best

    def play(self):
        print("--- Unbeatable Tic-Tac-Toe AI ---")
        print("Positions are numbered 0 through 8 starting top-left to bottom-right.")
        self.print_board()

        while self.empty_squares() and not self.is_terminal():
            # Human Turn
            valid_move = False
            while not valid_move:
                try:
                    move = int(input("Enter position (0-8): "))
                    if move in self.available_moves():
                        self.make_move(move, self.human)
                        valid_move = True
                    else:
                        print("Invalid move. Square is occupied or out of bounds.")
                except ValueError:
                    print("Please enter an integer between 0 and 8.")

            self.print_board()

            if self.is_terminal():
                break

            # AI Turn
            print("AI is making a move...")
            ai_move = self.minimax(self.board, 0, True)['position']
            self.make_move(ai_move, self.ai)
            self.print_board()

        # Final Game Result
        if self.check_winner(self.board, self.human):
            print("Congratulations! You won!")
        elif self.check_winner(self.board, self.ai):
            print("AI wins! Better luck next time.")
        else:
            print("It's a draw!")

if __name__ == "__main__":
    game = TicTacToeAI()
    game.play()
